#!/bin/sh
set -eu
directory="$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)"
root="$(CDPATH= cd -- "$directory/.." && pwd -P)"
[ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || { printf '%s\n' 'Requires an Apple Silicon Mac.' >&2; exit 1; }
sh "$directory/Verify-BetaPackage.command"
if [ "${1:-}" = --validate-only ]; then printf '%s\n' 'PASS preflight; no installation or permissions changed.'; exit 0; fi
staging="$(mktemp -d "${TMPDIR:-/tmp}/LinkBridge-beta-install.XXXXXX")"
/usr/bin/ditto -x -k "$root/02-macOS/LinkBridge-0.0.4-beta.1-macOS-arm64.zip" "$staging"
sh "$staging/LinkBridge-macOS/Install.command"
/usr/bin/codesign --verify --deep --strict "$HOME/Applications/LinkBridge.app"
printf '%s\n' 'Installed. Open ~/Applications/LinkBridge.app in Finder and let the owner review macOS prompts.'
printf '%s\n' 'Next: import the mac.settings.json generated by the Windows pairing assistant, then configure screen layout.'
